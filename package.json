{
  "name": "workout-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first, mobile-first PWA for tracking a sequential 32-workout program, with optional free Supabase account sync.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate:session": "npx tsx scripts/validate-session.ts",
    "validate:phase2": "npx tsx scripts/validate-session.ts",
    "validate:v2": "npx tsx scripts/validate-v2-program.ts",
    "validate:v3-program": "npx tsx scripts/validate-v3-program.ts",
    "validate:history": "npx tsx scripts/validate-history.ts",
    "validate:history-migration": "npx tsx scripts/validate-history-migration.ts",
    "validate:nutrition": "npx tsx scripts/validate-nutrition.ts",
    "validate:cloud-sync": "npx tsx scripts/validate-cloud-sync.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
